# The single source of configuration for the API, the web app and tooling.
# Copy to .env (git-ignored). The Makefile exports it to the API and to
# migrations, and web/next.config.ts loads it for Next.js. Do not create
# web/.env* files.

# Database. Matches compose.yaml, the project's own Postgres on port 55440.
POSTGRES_USER=foodies
POSTGRES_PASSWORD=foodies
POSTGRES_DB=foodies
POSTGRES_PORT=55440
DATABASE_URL=postgres://foodies:foodies@localhost:55440/foodies?sslmode=disable

# API
HTTP_ADDR=:8080
# Signs access tokens. Generate your own with: openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only

# Demo data only (make seed-demo). Every demo user gets these credentials.
SEED_PASSWORD=foodies-demo
SEED_PIN=246810

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
